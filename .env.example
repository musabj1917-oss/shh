# Haiku Messenger API environment template
# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/haiiku
# Local-development-only fallback is used if omitted; set a unique random secret in deployment.
JWT_SECRET=replace-this-with-a-unique-random-secret-at-least-32-characters
# Optional OAuth settings (configure only when the corresponding provider is implemented).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
