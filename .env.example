# Copy to .env for local API development. Keep actual secrets out of Git.
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
ADMIN_WEB_URL=http://localhost:3000
# Base used to build shareable group invitation links. Set an HTTPS universal-link
# base in production if one is configured; the custom scheme works without a domain.
MOBILE_INVITE_BASE_URL=haikumessenger://join/
HAIKU_API_URL=http://localhost:3001/v1
HAIKU_API_BASE_URL=http://localhost:3001/v1
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
SESSION_TTL_DAYS=30
CRON_SECRET=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Haiku Messenger <no-reply@example.invalid>
DEV_EMAIL_ECHO=true
ABLY_API_KEY=
# Media storage mode: 'local' for development, 'neon-s3' for S3/R2, 'b2' for Backblaze B2
MEDIA_STORAGE=local

# Backblaze B2 Storage (S3-compatible)
# Enable by setting MEDIA_STORAGE=b2
B2_BUCKET=haiku-media
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
# Optional CDN or public download URL (e.g. Cloudflare Bandwidth Alliance for free egress)
B2_CDN_URL=

# Cloudflare R2 / S3-compatible object storage (the "black bricks r2" bucket)
# S3_BUCKET / MEDIA_BUCKET: Name of the bucket (e.g. black-bricks-r2 or haiku-media)
S3_BUCKET=haiku-private
MEDIA_BUCKET=haiku-private

# S3_ENDPOINT: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
AWS_ENDPOINT_URL_S3=

# Cloudflare R2 region is always 'auto'
S3_REGION=auto
AWS_REGION=auto

# R2 API token credentials with Object Read & Write permissions scoped to the bucket
S3_ACCESS_KEY_ID=
AWS_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
REPORT_RETENTION_DAYS=365
ACCOUNT_DELETION_GRACE_DAYS=30
ADMIN_BOOTSTRAP_CONFIRM=
