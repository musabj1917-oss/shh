{
  "name": "@haiku/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/dev.ts",
    "start": "node --import tsx src/dev.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test ../../tests/*.test.ts",
    "migrate": "node ../../scripts/migrate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@haiku/contracts": "file:../../packages/contracts",
    "@hono/node-server": "1.19.10",
    "@neondatabase/serverless": "1.2.0",
    "@vercel/blob": "^2.8.2",
    "ably": "2.30.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "11.3.1",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "nodemailer": "10.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
