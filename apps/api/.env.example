NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:3001
ADMIN_WEB_URL=http://localhost:3000
MOBILE_INVITE_BASE_URL=haikumessenger://join/
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
SESSION_TTL_DAYS=30
CRON_SECRET=replace-with-a-long-random-value
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Haiku Messenger <no-reply@example.invalid>
DEV_EMAIL_ECHO=true
ABLY_API_KEY=
# Messaging Media Storage (Neon Object Storage / S3-compatible)
MEDIA_STORAGE=local
MEDIA_BUCKET=haiku-private
AWS_REGION=us-east-1
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# APK Distribution Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx
VERCEL_BLOB_APK_URL=

# Firebase Backend (Auth & FCM Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or alternatively:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
